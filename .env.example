# Unico file di configurazione locale: lo leggono Docker Compose e Payload.
# Copialo in .env (che non va in Git) oppure lascia che lo generi `npm run init`.

# --- Docker Compose -------------------------------------------------------
# Il nome separa contenitori e volumi tra copie diverse della base.
COMPOSE_PROJECT_NAME=NOME_PROGETTO

# --- Database (usati da Compose e da Payload) ------------------------------
DB_USER=NOME_UTENTE
DB_PASSWORD=SOSTITUISCI_CON_UNA_PASSWORD_CASUALE
DB_NAME=NOME_DATABASE
DB_PORT=5433
# Facoltativo: se impostato, Payload usa questo indirizzo al posto di quello
# ricavato dalle variabili DB_* (utile con un database esterno).
# DATABASE_URL=postgres://utente:password@host:5432/nome

# --- Porte sul computer (cambiale per avviare più copie insieme) -------------
CMS_PORT=3000
SITE_PORT=4322
# Facoltativo, solo in produzione (npm run start:cms): l'indirizzo su cui il CMS ascolta.
# Senza, tutte le interfacce; con un proxy sullo stesso server conviene 127.0.0.1.
# CMS_HOST=127.0.0.1

# Indirizzo del CMS da cui il sito legge i contenuti (npm run contenuti:aggiorna). Se manca si usa
# http://localhost:CMS_PORT; serve solo se il CMS sta su un altro computer.
# CMS_URL=https://cms.esempio.it
# Chiave di lettura con cui lo snapshot legge anche i campi riservati (le email del Team).
# La crea e la scrive qui `npm run chiave:snapshot`; senza, le email non arrivano al sito.
CMS_API_KEY=

# --- Payload ---------------------------------------------------------------
PAYLOAD_SECRET=SOSTITUISCI_CON_UNA_STRINGA_CASUALE_LUNGA
# Cartella dei file caricati (immagini e documenti). Un percorso relativo parte dalla radice del repository. In produzione deve stare su un volume persistente.
# MEDIA_DIR=media

# Solo per prototipare in locale: crea le tabelle senza migrazioni.
# Lasciare false sui database che usano le migrazioni.
PAYLOAD_DB_PUSH=false
