{
  "name": "brainy-starter-payload",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Base riutilizzabile Astro + Payload CMS + PostgreSQL per siti statici di associazioni e piccole aziende",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "init": "node scripts/init.mjs",
    "dev": "npm run dev -w apps/site",
    "dev:site": "npm run dev -w apps/site",
    "dev:cms": "npm run dev -w apps/cms",
    "dev:all": "concurrently --kill-others-on-fail -n sito,cms -c cyan,magenta \"npm:dev:site\" \"npm:dev:cms\"",
    "start:cms": "npm run start -w apps/cms",
    "build": "npm run build -w apps/site",
    "preview": "npm run preview -w apps/site",
    "check": "npm run check -w apps/site",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "seed": "npm run seed -w apps/cms --",
    "contenuti:aggiorna": "npm run contenuti:aggiorna -w apps/site --"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
