{
  "name": "cms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pannello e API Payload CMS (Next.js) della base riutilizzabile",
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "node scripts/next.mjs start",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed.ts",
    "chiave:snapshot": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/chiave-snapshot.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@brainy/content": "*",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "^10.1.0",
    "graphql": "^16.14.2",
    "next": "16.4.0",
    "payload": "3.90.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
