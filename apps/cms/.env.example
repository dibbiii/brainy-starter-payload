# Copia questo file in .env (che non va in Git) e sostituisci i valori.
# In seguito li genererà lo script di inizializzazione.
DATABASE_URL=postgres://UTENTE:PASSWORD@localhost:5433/NOME_DATABASE
PAYLOAD_SECRET=SOSTITUISCI_CON_UNA_STRINGA_CASUALE_LUNGA

# Solo per prototipare in locale: crea le tabelle senza migrazioni.
# Lasciare false (o rimuovere) sui database che usano le migrazioni.
PAYLOAD_DB_PUSH=false
