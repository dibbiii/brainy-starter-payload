---
// Tutte le altre pagine create nel CMS: /chi-siamo, /contatti, /privacy, …
// e le pagine di dettaglio delle attività: /discipline/biathlon (il prefisso si
// imposta in Impostazioni → Dati del sito).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Blocks from '../components/Blocks.astro';
import PageHeader from '../components/PageHeader.astro';
import ActivityDetail from '../components/ActivityDetail.astro';
import SectionNav from '../components/SectionNav.astro';
import ShareLinks from '../components/ShareLinks.astro';
import { wrap } from '../lib/ui';
import { allActivities, activitiesPath } from '../lib/activities';

export async function getStaticPaths() {
  const pages = await getCollection('pages', (p) => p.id !== 'home');
  const activities = await allActivities();
  return [
    ...pages.map((page) => ({ params: { slug: page.id }, props: { page, activity: undefined } })),
    ...activities.map((activity) => ({
      params: { slug: `${activitiesPath}/${activity.id}` },
      props: { page: undefined, activity },
    })),
  ];
}

const { page, activity } = Astro.props;
const data = page?.data;
const sections = data?.sections ?? [];
const startsWithHero = sections[0]?.type === 'hero';
---
{activity ? (
  <ActivityDetail activity={activity} />
) : data && (
  <Base title={data.title} description={data.description} hideFooterSponsors={sections.some((s) => s.type === 'sponsors')}>
    {data.show_title && !startsWithHero && (
      <PageHeader title={data.title} description={data.description} image={data.header_image} imageAlt={data.header_image_alt} />
    )}
    <Blocks sections={sections} />
    {data.show_share && <div class={wrap}><ShareLinks title={data.title} /></div>}
    <SectionNav path={Astro.url.pathname} />
  </Base>
)}
