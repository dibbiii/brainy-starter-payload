---
import Base from '../layouts/Base.astro';
import { wrap, section, segnavia, lead, button, buttonPad } from '../lib/ui';
---
<Base title="Pagina non trovata">
  <div class:list={[wrap, section]}>
    <span class={segnavia} aria-hidden="true"></span>
    <h1>Qui il sentiero finisce</h1>
    <p class={lead}>La pagina che cerchi non esiste o è stata spostata.</p>
    <p><a class:list={[button, buttonPad]} href="/">Torna alla home</a></p>
  </div>
</Base>
