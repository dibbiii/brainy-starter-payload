---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import NewsArticleBody from '../../components/NewsArticleBody.astro';
import NewsSidebar from '../../components/NewsSidebar.astro';
import { site } from '../../lib/site';
import { formatDate } from '../../lib/format';
import { publishedNews } from '../../lib/news';
import { wrap } from '../../lib/ui';

export async function getStaticPaths() {
  const posts = await publishedNews();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, date, excerpt, cover } = post.data;
const { Content } = await render(post);

const band = site.page_header_style === 'band';
const sidebar = Boolean(site.news_sidebar);
const crumbs = [{ label: 'Home', url: '/' }, { label: 'News', url: '/news' }, { label: title }];
const space = 'py-[clamp(2.5rem,7vw,5rem)]';
---
<Base title={title} description={excerpt} image={cover}>
  {band && <PageHeader title={title} description={formatDate(date)} crumbs={crumbs} />}
  {sidebar ? (
    <div class:list={[wrap, space, 'grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem]']}>
      <article class="min-w-0"><NewsArticleBody post={post} Content={Content} band={band} /></article>
      <NewsSidebar currentId={post.id} />
    </div>
  ) : (
    <article class:list={[wrap, space]}><NewsArticleBody post={post} Content={Content} band={band} /></article>
  )}
</Base>
