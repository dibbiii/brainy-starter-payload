---
// Il menu mobile usa <details>: funziona senza JavaScript.
import { site } from '../lib/site';
import { resolvedMenu } from '../lib/menu';
import { wrap, button, buttonPadSm } from '../lib/ui';
const menu = await resolvedMenu();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (url?: string) => {
  if (!url) return false;
  const clean = url.split('#')[0].replace(/\/$/, '') || '/';
  return clean === '/' ? path === '/' : path === clean || path.startsWith(clean + '/');
};
// Senza logo si vede sempre il nome; con il logo solo se l'editor lo chiede.
const showText = !site.logo || site.show_name_with_logo;
const hasButton = Boolean(site.header_button_label && site.header_button_url);

const topLink = 'block py-[0.6rem] text-ink no-underline font-semibold hover:text-accent aria-[current=page]:text-accent';
---
<header class="sticky top-0 z-20 bg-paper border-b border-line">
  <div class:list={[wrap, 'flex items-center justify-between gap-4 min-h-[4.25rem]']}>
    <a class="flex items-center gap-[0.65rem] min-w-0 font-heading font-bold text-[1.6rem] text-ink no-underline leading-none hover:text-accent" href="/">
      {site.logo && <img class="h-12 w-auto" src={site.logo} alt={showText ? '' : site.name} height="48" />}
      {showText && (
        <span class="flex flex-col gap-[0.2rem]">
          <span>{site.name}</span>
          {site.header_subtitle && <span class="max-sm:hidden font-body text-[0.7rem] font-semibold tracking-[0.08em] uppercase text-muted">{site.header_subtitle}</span>}
        </span>
      )}
    </a>
    <div class="flex items-center gap-3">
    <details data-nav class="group nav:details-content:contents nav:details-content:[content-visibility:visible]">
      <summary class="list-none cursor-pointer font-semibold px-[0.9rem] py-2 border-2 border-ink rounded-brand group-open:bg-ink group-open:text-paper nav:hidden [&::-webkit-details-marker]:hidden"><span>Menu</span></summary>
      <nav aria-label="Principale" class="max-nav:absolute max-nav:inset-x-0 max-nav:top-full max-nav:bg-paper max-nav:border-b max-nav:border-line max-nav:px-gutter max-nav:pt-2 max-nav:pb-5 max-nav:max-h-[calc(100vh-4.25rem)] max-nav:overflow-y-auto nav:block">
        <ul class="nav:flex nav:gap-7">
          {menu.map((item) => (
            <li class="group/item max-nav:border-t max-nav:border-line nav:relative">
              {item.url
                ? <a class={topLink} href={item.url} aria-current={isActive(item.url) ? 'page' : undefined}>{item.label}</a>
                : <span class="block py-[0.6rem] text-ink font-semibold">{item.label}</span>}
              {item.children && item.children.length > 0 && (
                <ul class="nav:hidden nav:absolute nav:top-full nav:-left-4 nav:min-w-56 nav:bg-paper nav:border nav:border-line nav:border-t-[3px] nav:border-t-accent nav:py-[0.4rem] nav:px-4 nav:group-hover/item:block nav:group-focus-within/item:block">
                  {item.children.map((c) => <li><a class="block py-[0.6rem] pl-4 nav:pl-0 text-ink no-underline font-normal hover:text-accent" href={c.url}>{c.label}</a></li>)}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </details>
    {hasButton && <a class:list={[button, buttonPadSm]} href={site.header_button_url}>{site.header_button_label}</a>}
    </div>
  </div>
</header>

<script>
  // Su desktop il <details> deve risultare sempre aperto; passando a mobile si richiude
  const nav = document.querySelector<HTMLDetailsElement>('[data-nav]');
  const mq = window.matchMedia('(min-width: 52.01rem)');
  const sync = () => { if (nav) nav.open = mq.matches; };
  sync();
  mq.addEventListener('change', sync);
</script>
