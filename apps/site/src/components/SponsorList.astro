---
// Elenco sponsor raggruppati per livello. Usato sia dal blocco "Sponsor" sia dal footer.
import { sponsors, tierLabels, type Sponsor } from '../lib/site';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const order: Sponsor['tier'][] = ['main', 'partner', 'institutional'];
const groups = order
  .map((tier) => ({ tier, items: sponsors.filter((s) => (s.tier ?? 'partner') === tier) }))
  .filter((g) => g.items.length > 0);

// Nella versione compatta (footer) tutti i livelli hanno la stessa dimensione.
// Le classi sono scritte per intero, così Tailwind le trova.
const logoSize = (tier: Sponsor['tier']) =>
  compact ? 'max-h-12' : tier === 'main' ? 'max-h-24' : 'max-h-16';
const nameSize = (tier: Sponsor['tier']) =>
  compact ? 'text-[1.15rem]' : tier === 'main' ? 'text-[1.9rem]' : 'text-[1.4rem]';
---
<div class:list={['grid', compact ? 'gap-5' : 'gap-8']}>
  {groups.map((g) => (
    <div>
      <h3 class="font-body text-[0.95rem] font-semibold text-muted mb-3">{tierLabels[g.tier]}</h3>
      <ul class="flex flex-wrap gap-x-10 gap-y-4 items-center">
        {g.items.map((s) => {
          const inner = s.logo
            ? <img class:list={[logoSize(g.tier), 'w-auto']} src={s.logo} alt={s.name} loading="lazy" />
            : <span class:list={['font-heading font-semibold', nameSize(g.tier)]}>{s.name}</span>;
          return <li>{s.url ? <a class="text-ink no-underline hover:text-accent" href={s.url} rel="noopener">{inner}</a> : inner}</li>;
        })}
      </ul>
    </div>
  ))}
</div>
