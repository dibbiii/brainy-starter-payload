---
import { md } from '../../lib/format';
import { wrap, section, prose } from '../../lib/ui';
interface Props { title?: string; content: string; image: string; image_alt?: string; image_side?: 'left' | 'right'; id?: string }
const { title, content, image, image_alt, image_side = 'right', id } = Astro.props;
---
<section class={section} id={id}>
  <div class:list={[wrap, 'grid gap-gutter items-center md:grid-cols-2 md:gap-[clamp(2rem,5vw,4.5rem)]']}>
    <div>
      {title && <h2>{title}</h2>}
      <div class={prose} set:html={md(content)} />
    </div>
    <img class:list={['w-full aspect-[4/3] object-cover rounded-brand', image_side === 'left' && 'md:order-first']} src={image} alt={image_alt ?? ''} loading="lazy" />
  </div>
</section>
