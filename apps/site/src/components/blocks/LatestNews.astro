---
import { getCollection } from 'astro:content';
import NewsCard from '../NewsCard.astro';
import { wrap, section } from '../../lib/ui';
interface Props { title?: string; count?: number; id?: string }
const { title, count = 3, id } = Astro.props;
const posts = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, count);
---
{posts.length > 0 && (
  <section class={section} id={id}>
    <div class={wrap}>
      <div class="flex justify-between items-baseline gap-4 flex-wrap">
        {title && <h2>{title}</h2>}
        <a class="font-semibold" href="/news">Tutte le news</a>
      </div>
      <div class="grid gap-x-gutter gap-y-10 grid-cols-[repeat(auto-fit,minmax(16rem,1fr))] mt-6">
        {posts.map((post) => <NewsCard post={post} />)}
      </div>
    </div>
  </section>
)}
