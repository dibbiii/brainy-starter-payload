---
// Galleria senza librerie: ogni foto si apre a piena risoluzione in una nuova scheda.
import { wrap, section } from '../../lib/ui';
interface Props { title?: string; images: { image: string; caption?: string }[]; id?: string }
const { title, images, id } = Astro.props;
---
<section class={section} id={id}>
  <div class={wrap}>
    {title && <h2>{title}</h2>}
    <ul class="grid gap-3 grid-cols-[repeat(auto-fill,minmax(14rem,1fr))] mt-8">
      {images.map((g) => (
        <li>
          <figure>
            <a href={g.image} target="_blank" rel="noopener">
              <img class="aspect-square object-cover w-full rounded-brand" src={g.image} alt={g.caption ?? ''} loading="lazy" />
            </a>
            {g.caption && <figcaption class="text-[0.9rem] text-muted mt-[0.35rem]">{g.caption}</figcaption>}
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
