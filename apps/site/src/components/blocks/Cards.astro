---
import { isExternal } from '../../lib/format';
import { wrap, section, lead } from '../../lib/ui';
interface Item { title: string; highlight?: string; text?: string; image?: string; url?: string }
interface Props { title?: string; intro?: string; items: Item[]; id?: string }
const { title, intro, items, id } = Astro.props;
---
<section class={section} id={id}>
  <div class={wrap}>
    {title && <h2>{title}</h2>}
    {intro && <p class={lead}>{intro}</p>}
    <ul class="grid gap-x-gutter gap-y-10 grid-cols-[repeat(auto-fit,minmax(15rem,1fr))] mt-10">
      {items.map((c) => (
        <li class="group relative border-t-[3px] border-ink pt-4">
          {c.image && <img class="aspect-[4/3] w-full object-cover mb-4 rounded-brand" src={c.image} alt="" loading="lazy" />}
          {c.highlight && <p class="text-accent font-bold mb-1">{c.highlight}</p>}
          <h3 class="text-[1.85rem] mb-[0.4rem]">
            {c.url
              ? <a class="text-ink no-underline group-hover:text-accent after:content-[''] after:absolute after:inset-0" href={c.url} rel={isExternal(c.url) ? 'noopener' : undefined}>{c.title}</a>
              : c.title}
          </h3>
          {c.text && <p class="text-muted m-0">{c.text}</p>}
        </li>
      ))}
    </ul>
  </div>
</section>
