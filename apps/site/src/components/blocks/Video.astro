---
// GDPR: nessuna richiesta a YouTube finché il visitatore non clicca.
// Poi si usa youtube-nocookie.com.
import { youtubeId } from '../../lib/format';
import { wrap, section, button, buttonPad } from '../../lib/ui';
interface Props { title?: string; url: string; id?: string }
const { title, url, id } = Astro.props;
const vid = youtubeId(url);
---
{vid && (
  <section class={section} id={id}>
    <div class={wrap}>
      {title && <h2>{title}</h2>}
      {/* [&_iframe]: serve perché l'iframe viene creato dallo script qui sotto */}
      <div class="aspect-video bg-ink text-paper rounded-brand overflow-hidden max-w-[56rem] [&_iframe]:w-full [&_iframe]:h-full [&_iframe]:border-0 [&_iframe]:block" data-video={vid}>
        <div class="h-full grid place-content-center justify-items-center text-center gap-4 p-6">
          <p class="max-w-[30rem] m-0">Il video è ospitato su YouTube. Se lo carichi, YouTube riceverà alcuni dati sulla tua visita, come l'indirizzo IP.</p>
          <button type="button" class:list={[button, buttonPad]}>Carica il video</button>
          <a class="text-paper text-[0.95rem]" href={`https://www.youtube.com/watch?v=${vid}`} rel="noopener">Oppure guardalo su YouTube</a>
        </div>
      </div>
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.video}?autoplay=1`;
      iframe.title = 'Video YouTube';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      box.replaceChildren(iframe);
    });
  });
</script>
