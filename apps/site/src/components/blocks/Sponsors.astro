---
import SponsorList from '../SponsorList.astro';
import { wrap, sectionTint, lead } from '../../lib/ui';
interface Props { title?: string; intro?: string; id?: string }
const { title, intro, id } = Astro.props;
---
<section class={sectionTint} id={id}>
  <div class={wrap}>
    {title && <h2>{title}</h2>}
    {intro && <p class={lead}>{intro}</p>}
    <div class="mt-8"><SponsorList /></div>
  </div>
</section>
