---
import { wrap, section, buttonGhost, buttonPad } from '../../lib/ui';
interface Props { title: string; text?: string; button_label: string; button_url: string; id?: string }
const { title, text, button_label, button_url, id } = Astro.props;
---
<section class={section} id={id}>
  <div class={wrap}>
    <div class="bg-primary text-paper rounded-brand p-[clamp(2rem,5vw,3.5rem)] flex flex-wrap gap-x-12 gap-y-6 items-center justify-between border-l-[0.75rem] border-accent">
      <div>
        <h2 class="mb-[0.25em]">{title}</h2>
        {text && <p class="m-0 max-w-[36rem]">{text}</p>}
      </div>
      <a class:list={[buttonGhost, buttonPad]} href={button_url}>{button_label}</a>
    </div>
  </div>
</section>
