---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/format';
interface Props { post: CollectionEntry<'news'> }
const { post } = Astro.props;
const { title, date, excerpt, cover, cover_alt } = post.data;
---
<article class="relative grid gap-[0.9rem] content-start">
  {cover && <img class="aspect-[3/2] object-cover w-full rounded-brand bg-line" src={cover} alt={cover_alt ?? ''} loading="lazy" />}
  <div>
    <time class="text-[0.9rem] text-muted" datetime={date.toISOString()}>{formatDate(date)}</time>
    {/* Tutta la scheda è cliccabile tramite il link del titolo (after:inset-0) */}
    <h3 class="mt-[0.2rem] mb-[0.4rem] text-[1.6rem]"><a class="text-ink no-underline hover:text-accent after:content-[''] after:absolute after:inset-0" href={`/news/${post.id}`}>{title}</a></h3>
    {excerpt && <p class="text-muted m-0">{excerpt}</p>}
  </div>
</article>
